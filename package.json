{
  "name": "operis",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack -p 8000",
    "dev:clean": "tsx scripts/clean-dev.ts",
    "prebuild": "tsx scripts/check-secrets.ts && tsx scripts/check-db-schema-sync.ts",
    "build": "next build --webpack",
    "start": "next start -p 8000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run audit:secrets && vitest run --config vitest.unit.config.ts && vitest run --config vitest.integration.config.ts && vitest run tests/a11y",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/run-e2e-prod.ts",
    "test:e2e:prod": "tsx scripts/run-e2e-prod.ts",
    "test:a11y": "vitest run tests/a11y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "audit:emoji": "tsx scripts/check-emojis.ts",
    "audit:i18n": "tsx scripts/check-i18n-parity.ts",
    "audit:schema": "tsx scripts/check-db-schema-sync.ts",
    "audit:secrets": "tsx scripts/check-secrets.ts",
    "test:concurrency": "tsx scripts/test-db-concurrency.ts",
    "worker": "tsx scripts/worker-daemon.ts",
    "worker:daemon": "tsx scripts/worker-daemon.ts",
    "backfill:pii": "tsx scripts/backfill-pii-keys.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:8000/api/inngest",
    "review": "ocr review",
    "review:delegate": "ocr delegate preview",
    "review:rules": "ocr delegate rule",
    "review:api": "ocr scan --path src/app/api",
    "review:preview": "ocr delegate preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@clerk/nextjs": "^7.9.2",
    "@sentry/nextjs": "^10.74.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "inngest": "^4.20.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-intl": "^3.26.5",
    "pg": "^8.13.3",
    "posthog-js": "^1.430.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "svix": "^2.5.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.8"
  },
  "packageManager": "pnpm@10.5.2"
}

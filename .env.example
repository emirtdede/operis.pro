# ==============================================================================
# FREELANCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Master Specification: FREELANCE_PLATFORM_MASTER_SPEC.md §59 & §18.7
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Core Application
NODE_ENV=development
APP_URL=http://localhost:3000
PRODUCT_NAME=Freelance Platform

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freelance_platform
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/freelance_platform

# Authentication & Sessions
AUTH_SECRET=replace_with_64_char_hex_random_secret_in_production
AUTH_URL=http://localhost:3000

# Clerk Authentication (Free Tier: 10,000 MAU + 5 Social Providers)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/tr/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/tr/kayit

# Private Identity Encryption & Blind Indexing
# 32-byte hex key for AES-256-GCM encryption of private identity fields
PII_ENCRYPTION_KEY_CURRENT=replace_with_64_hex_chars_32_bytes
PII_ENCRYPTION_KEY_PREVIOUS=
# 32-byte hex key for HMAC-SHA256 blind indexing of phone numbers
PII_HMAC_KEY=replace_with_64_hex_chars_32_bytes

# Transactional Email Provider (mock | resend | smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@freelance-platform.local
EMAIL_API_KEY=

# SMS OTP Provider (mock | twilio | netgsm)
SMS_PROVIDER=mock
SMS_API_KEY=

# Observability & Developer Integrations
OBSERVABILITY_PII_REDACTION=true

# Product Analytics (PostHog - Free Tier: 1M events/month)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Bot Protection (Cloudflare Turnstile - 100% Free & Unlimited)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# Cloudflare R2 Object Storage (Free Tier: 10 GB Storage, $0 Egress/Bandwidth)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=operis-avatars
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.operis.pro

# Error Monitoring & Crash Reporting (Sentry - Free Tier: 5,000 errors/month)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.de.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...

# Serverless Redis & Distributed Rate Limiting (Upstash - Free Tier: 10,000 commands/day)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Serverless Background Workflows & Queues (Inngest - Free Tier: 50,000 runs/mo, no card required)
# Local Dev UI: npm run inngest:dev (opens http://localhost:8288)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Uptime & Heartbeat Monitoring (Better Stack - Free Tier: 10 monitors, 3m intervals)
# Health Endpoint: https://operis.pro/api/health
# Public Status Page: https://status.operis.pro

# Feature Flags (All must default false unless authorized)
FEATURE_IDENTITY_VERIFICATION=false
FEATURE_MARKETING_EMAIL=false
FEATURE_PUBLIC_OFFER_COUNT=false

# Legal & Compliance Configuration (§18.7)
# In production, these must be non-empty and validated.
LEGAL_ENTITY_NAME=Platform Teknoloji Anonim Sirketi
LEGAL_ENTITY_TYPE=Anonim Sirket
LEGAL_ADDRESS=Buyukdere Cad. No: 100 Sisli, Istanbul, Turkiye
LEGAL_SUPPORT_EMAIL=destek@freelance-platform.local
LEGAL_PRIVACY_EMAIL=kvkk@freelance-platform.local
LEGAL_PHONE=+90 212 555 0100
MERSIS_NO=0123456789000001
TAX_NO=1234567890
KEP_ADDRESS=platform@hs01.kep.tr
TERMS_EFFECTIVE_DATE=2026-09-06
PRIVACY_EFFECTIVE_DATE=2026-09-06
LEGAL_ETBIS_CLASSIFICATION_APPROVED=true
LEGAL_PRIVACY_REVIEW_APPROVED=true

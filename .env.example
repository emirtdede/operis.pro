# ==============================================================================
# OPERİS — CANLI & YAYIN ÖNCESİ ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# Master Specification: FREELANCE_PLATFORM_MASTER_SPEC.md §59 & §18.7
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# 1. Çekirdek Uygulama Yapılandırması (Core Application)
NODE_ENV=production
APP_URL=https://operis.pro
PRODUCT_NAME=Operis

# 2. Veritabanı (PostgreSQL / Supabase Connection Architecture)
# Runtime Application (Serverless): Supabase Transaction Pooler (Port 6543)
DATABASE_URL=postgres://postgres.[REF]:[PASSWORD]@[POOLER_HOST].pooler.supabase.com:6543/postgres
# Migration / DDL / Admin Tooling: Supabase Direct Connection (Port 5432) or Session Pooler (Port 5432 if IPv4)
DATABASE_MIGRATION_URL=postgres://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# 3. Oturum & Güvenlik Şifrelemesi (Authentication & Sessions)
# 64 karakterli kriptografik hex anahtar (Üretim: openssl rand -hex 32)
AUTH_SECRET=replace_with_64_char_hex_random_secret_in_production
AUTH_URL=https://operis.pro

# 4. Acil Durum Yönetim & Admin Güvenliği (WP-44 & WP-45)
# En az 32 karakterli güçlü yönetim anahtarı (Üretim: openssl rand -hex 32)
ADMIN_MASTER_KEY=replace_with_very_strong_random_admin_master_key_2026
ENABLE_DEMO_LOGIN=false
ALLOW_DEMO_CREDENTIALS=false

# 5. Clerk Canlı Kimlik Doğrulama (Clerk Production Mode - WP-37)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/tr/giris
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/tr/kayit

# Sosyal Giriş Şartlı Bayrakları (WP-40)
NEXT_PUBLIC_ENABLE_OAUTH_APPLE=false

# 6. Kişisel Veri Şifreleme & Blind Indexing (KVKK / AES-256-GCM - §20)
# 32-byte hex anahtar (64 hex karakter)
PII_ENCRYPTION_KEY_CURRENT=replace_with_64_hex_chars_32_bytes_current
PII_ENCRYPTION_KEY_PREVIOUS=
# HMAC-SHA256 blind index anahtarı (Telefon arama ve tekillik için)
PII_HMAC_KEY=replace_with_64_hex_chars_32_bytes_hmac

# 7. Kurumsal E-Posta Servisi (Resend - WP-54)
EMAIL_PROVIDER=resend
EMAIL_FROM=Operis <bildirim@operis.pro>
EMAIL_API_KEY=re_live_...

# 8. SMS OTP Sağlayıcısı (Netgsm / Twilio - WP-55)
SMS_PROVIDER=netgsm
SMS_API_KEY=
SMS_SENDER_HEADER=OPERIS
FEATURE_SMS_OTP=true

# 9. Bot Koruma Kalkanı (Cloudflare Turnstile - WP-57)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAA...

# 10. Nesne Depolama (Cloudflare R2 Storage - Avatar ve Sözleşme İmzaları)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=operis-avatars
NEXT_PUBLIC_R2_PUBLIC_URL=https://r2.operis.pro

# 11. Hata & Çökme Takibi (Sentry Production)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.de.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...

# 12. Dağıtık Hız Sınırlama (Upstash Serverless Redis)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# 13. Arka Plan İş Kuyrukları (Inngest Serverless Workflows)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# 14. Kesinti & Sistem Sağlığı İzleme (Better Stack)
# Sağlık Uç Noktası: https://operis.pro/api/health
# Kamusal Durum Sayfası: https://status.operis.pro

# 15. Hukuki & Kurumsal Bilgiler (KVKK, TTK, ETBİS - WP-51 & WP-52)
LEGAL_ENTITY_NAME=Operis Teknoloji Anonim Şirketi
LEGAL_ENTITY_TYPE=Anonim Şirket
LEGAL_ADDRESS=Resmi Şirket Tebligat Adresi, İstanbul, Türkiye
LEGAL_SUPPORT_EMAIL=destek@operis.pro
LEGAL_PRIVACY_EMAIL=kvkk@operis.pro
LEGAL_PHONE=+90 212 555 0100
MERSIS_NO=0123456789000001
TAX_NO=1234567890
KEP_ADDRESS=operis@hs01.kep.tr
TERMS_EFFECTIVE_DATE=2026-09-23
PRIVACY_EFFECTIVE_DATE=2026-09-23
LEGAL_ETBIS_CLASSIFICATION_APPROVED=true
LEGAL_PRIVACY_REVIEW_APPROVED=true
NEXT_PUBLIC_ETBIS_CODE=
